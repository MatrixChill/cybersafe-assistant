{
  "name": "@cybersafe/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "node -e \"console.log('service typecheck delegated to shared/core/native workspaces')\""
  },
  "dependencies": {
    "@cybersafe/core": "0.1.0",
    "@cybersafe/native-windows": "0.1.0",
    "@cybersafe/shared-types": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
