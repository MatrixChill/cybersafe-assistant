# Configuration template: placeholders only, not a launch recipe.
# The isolated runner must supply real per-run paths and a random JWT secret.
NODE_ENV=development
CYBERSAFE_DEV_ISOLATION=1
CYBERSAFE_API_PORT=4100
CYBERSAFE_DB_PATH=<isolated-run-api-db-path>
JWT_SECRET=<generate-random-secret-at-runtime-minimum-32-characters>
# Optional online MATRIX: configure only on backend, never renderer or public repository.
CYBERSAFE_AI_PROVIDER=groq
CYBERSAFE_AI_BASE_URL=https://api.groq.com/openai/v1
CYBERSAFE_AI_MODEL=openai/gpt-oss-120b
CYBERSAFE_AI_API_KEY=<your-authorized-test-key>
