# Base de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybersafe_assistant?schema=public"

# Autenticação JWT (usa um segredo forte em produção)
JWT_SECRET="altera-isto-em-producao"

# ── IA da Matrix (padrão OpenAI-compatible; troca de provider sem tocar na UI) ──
# Provider: rótulo informativo (ex.: groq, openai, anthropic-via-gateway, custom)
CYBERSAFE_AI_PROVIDER=groq
# Chave da API — NUNCA commits esta linha com valor real.
CYBERSAFE_AI_API_KEY=
# Base URL OpenAI-compatible (default: Groq). Para OpenAI puro: https://api.openai.com/v1
CYBERSAFE_AI_BASE_URL=https://api.groq.com/openai/v1
# Modelo (default Groq: llama-3.1-8b-instant). Para OpenAI: gpt-4o-mini
CYBERSAFE_AI_MODEL=groq/compound

# Compatibilidade: se CYBERSAFE_AI_API_KEY estiver vazia, usa GROQ_API_KEY ou OPENAI_API_KEY.
GROQ_API_KEY=
OPENAI_API_KEY=

# VirusTotal — scans na cloud (opcional mas recomendado no core/serviço)
VIRUSTOTAL_API_KEY=
