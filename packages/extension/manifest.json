{
  "manifest_version": 3,
  "name": "CyberSafe Assistant",
  "version": "0.1.0",
  "description": "Educational security assistant — monitors URLs, downloads, and shows safety warnings.",
  "permissions": [
    "tabs",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CyberSafe Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
