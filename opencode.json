      "npm run test:*`": "deny",
      "npm run test:*$": "deny",
      "npm run test:* >*": "deny",
      "npm run test:* 2>*": "deny",
      "npm run test:* > *": "deny",
      "npm run typecheck && *": "deny",
      "npm run typecheck || *": "deny",
      "npm run typecheck ; *": "deny",
      "npm run typecheck | *": "deny",
      "npm run typecheck & *": "deny",
      "npm run typecheck`": "deny",
      "npm run typecheck$": "deny",
      "npm run typecheck >*": "deny",
      "npm run typecheck 2>*": "deny",
      "npm run typecheck > *": "deny"
