      "npm test & *": "deny",
      "npm test`": "deny",
      "npm test$": "deny",
      "npm test >*": "deny",
      "npm test 2>*": "deny",
      "npm test > *": "deny",
      "npm run test && *": "deny",
      "npm run test || *": "deny",
      "npm run test ; *": "deny",
      "npm run test | *": "deny",
      "npm run test & *": "deny",
      "npm run test`": "deny",
      "npm run test$": "deny",
      "npm run test >*": "deny",
      "npm run test 2>*": "deny",
      "npm run test > *": "deny",
      "npm run test:* && *": "deny",
