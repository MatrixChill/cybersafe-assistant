{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git diff --check*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git rev-parse*": "allow",
      "git fetch*": "allow",
      "git config*": "ask",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git cherry-pick*": "ask",
      "git reset*": "deny",
      "git restore*": "deny",
      "git checkout --*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git filter-branch*": "deny",
      "git reflog expire*": "deny",
      "git remote remove*": "deny",
      "git remote set-url*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm i -D *": "ask",
      "npm ci*": "ask",
      "npm exec*": "ask",
      "npm audit fix": "ask",
      "npm restart": "ask",
      "npm run build*": "ask",
      "npm run dev*": "ask",
      "npm run *": "ask",
      "npm publish*": "deny",
      "npm unpublish*": "deny",
      "npm deprecate*": "deny",
      "npx*": "ask",
      "node*": "ask",
      "sh *": "ask",
      "sh": "ask",
      "bash *": "ask",
      "bash": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "invoke-webrequest*": "ask",
      "powershell*": "deny",
      "powershell.exe*": "deny",
      "pwsh*": "deny",
      "cmd /c*": "deny",
      "cmd.exe /c*": "deny",
      "wsl*": "deny",
      "iex*": "deny",
      "invoke-expression*": "deny",
